# Log files
*.log
backups/
__pycache__/
.DS_Store

# Dev-time only, never deployed. GitHub Pages serves static files from app/ and runs
# nothing, so these exist purely to build content and to test the Firestore rules locally.
node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Environment files
.env
.env.example
.env.template
nnrpi/

# SSL certificates
ssl_certs/*cert.conf
ssl_certs/*cert.pem
ssl_certs/*key.pem

# flask session
flask_session/

# Credentials
data/Credentials.json*
data/Collaboration.json*
data/*db*

# Shell script
run_app.sh

# Static migration planning artifacts (never commit)
doc/static-migration-plan.md
doc/prompt/
doc/changelog.md

# Authored Q&A source. The build (npm run build:content) converts these into
# app/content/questions/en/**.json, which IS committed — we keep one copy of the
# Q&A in the repo, not two. Note the JSON is a lossy derivative: items with no
# A-D options (STAAR griddables, free-response) are not carried over.
doc/questionnaire/