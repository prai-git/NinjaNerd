rules_version = '2';

/* NinjaNerd Firestore Security Rules.

   These rules ARE the security boundary. The Firebase web config in app/js/firebase-config.js
   is public and grants nothing on its own; everything below decides who may read or write.

   This file is also where the DATA MODEL is documented. Nothing under doc/ is tracked, so a
   plan or checklist there cannot be relied on; the model lives here because this file is a
   deployed artifact and cannot drift out of the repo.

   The document model mirrors the legacy SQLite schema (obs_sqlite_manager.py) so that Audit,
   Statistics and progress tracking keep working the way they did in the Flask app. Legacy
   table names are shown against each collection.

   ON THE obs_* NAMES BELOW: they are the retired Flask app, DELETED from the working tree in
   the obs_ purge (2026-09-01) and recoverable only from git history -- `git log --all --
   <name>`, or browse the tree at the commit before the purge. They are cited here as
   PROVENANCE, not as paths you can open: each one records where a field or a decision came
   from, which is the evidence that this schema was derived from the old app rather than
   invented. Do not delete these citations because the files are gone; that is exactly when
   they start earning their keep.

     users/{uid}                             <- users
       email                : string           # also the login identifier
       school_name          : string           # optional, from the signup form
       is_admin             : boolean          # IMMUTABLE from the client; see below
       created_at           : timestamp
       updated_at           : timestamp
       # `password` is gone: Firebase Auth owns credentials.

     users/{uid}/history/{autoId}            <- user_history
       question             : string           # question text, as the legacy column stored it
       user_answer          : string
       correct              : boolean
       topic                : string           # "math" | "english" | "science"
       subtopic             : string
       grade                : number           # 1-7
       timestamp            : timestamp

     users/{uid}/statistics/summary          <- user_statistics + JSON store
       last_login           : timestamp        # from the SQLite user_statistics table
       questions_attempted  : number           # NOT in SQLite; from obs_db_manager.py
       topics_covered       : string[]         # NOT in SQLite; from obs_db_manager.py (both retired)

   On `statistics`: the legacy app had TWO storage backends. The SQLite user_statistics table
   holds only user_id + last_login, while the JSON store (obs_db_manager.py) holds
   questions_attempted and topics_covered[]. Audit reads all three, so this single document is
   the union of both — not a copy of the SQLite table alone.

   One deliberate adaptation, flagged rather than invented:
   - Integer user_id foreign keys become Firebase Auth **uid** strings.

   Deliberately dropped: user_payments (no payments on the static site),
   email_verification_codes (Firebase Auth handles verification), schema_info (Firestore is
   schemaless) and users.password (Auth owns credentials).

   DROPPED 2026-09-01 by owner decision -- collaboration/chat: the legacy `invites`
   (collaboration_invites), `chat_sessions` and `messages` tables. Child-to-child messaging
   carries the heaviest COPPA obligation in the app and nothing else depends on it, so the
   feature is not being built. The rules that used to allow those collections are removed
   rather than left dormant: a dormant allow is still an open write surface, and any signed-in
   user could have opened a session against any uid and stored free text in it. They now fall
   to the default deny at the bottom of this file. Restoring the feature means restoring these
   rules, not just shipping UI.

   COMPOSITE INDEXES: dbmgr/firestore.indexes.json is intentionally empty. Firestore creates
   single-field indexes automatically, which covers the simple queries planned so far; a
   composite index is needed only for a filter plus a sort on different fields, e.g.
     - history where topic == X && grade == N ordered by timestamp (Statistics computes
       percent-correct per topic for one grade, so this one is likely)
   Add them from the real queries in prompt 08 rather than guessing: Firestore fails a
   query needing a missing index and prints a console link that creates it.

   The app serves children (grades 1-7), so the default is deny and every allow is explicit. */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* Legacy admin was the fixed account admin@gmail.com (obs_app.py is_admin_user), and the
       users table carried an is_admin flag. A static site has no server able to mint custom
       claims, so admin status is read from the requester's own user document. That is only
       safe because is_admin is immutable from the client (see the users rules below) and a new
       account cannot create itself as admin; without those two guards any account could
       promote itself and read every child's history.

       TO GRANT ADMIN: open the Firestore console and set is_admin: true by hand on that
       person's users/{uid} document. There is no in-app path, by design. */
    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ---- users -------------------------------------------------------------------------
    match /users/{uid} {
      // Owner reads their own profile. Admin reads ANY profile: the Audit page looks a user up
      // by email, which needs both get and list over this collection.
      allow read: if isOwner(uid) || isAdmin();

      /* Shape validation, for the same reason as history below: signing up is free, so an
         authenticated client could otherwise store megabytes of arbitrary fields on its own
         profile document. school_name is a signup-form free-text field and was unbounded. */
      function validProfile(d) {
        return d.keys().hasOnly(
                 ['email', 'school_name', 'is_admin', 'created_at', 'updated_at'])
               && d.email is string && d.email.size() <= 254   // RFC 5321 maximum
               && d.school_name is string && d.school_name.size() <= 200
               && d.is_admin is bool;
      }

      // A new account can never create itself as an admin.
      allow create: if isOwner(uid)
                    && validProfile(request.resource.data)
                    && request.resource.data.is_admin == false;

      // is_admin and email cannot be changed by the client. Removing this makes every account
      // able to promote itself and read every child's history.
      allow update: if isOwner(uid)
                    && validProfile(request.resource.data)
                    && request.resource.data.is_admin == resource.data.is_admin
                    && request.resource.data.email == resource.data.email;

      allow delete: if isOwner(uid);

      /* user_history: the record Statistics and Audit are both computed from.

         The shape is validated here, not just the ownership. Being signed in is cheap -- any
         address can create a verified account -- so "isOwner" alone let an authenticated
         client append documents of any shape and size to its own subtree. Firestore bills for
         storage and for writes, and the ceiling was one 1 MiB document per write, forever.
         The caps below are ~4x the largest real value in app/content (longest authored
         question: 927 characters; longest option: 262), so they cannot reject a genuine save.

         The timestamp is pinned to the server's clock. A client-chosen value could be
         backdated or post-dated, which would reorder the Statistics view and corrupt the
         Audit trail -- the one collection whose whole purpose is being trustworthy. */
      match /history/{entryId} {
        function validHistory(d) {
          return d.keys().hasOnly(
                   ['question', 'question_id', 'user_answer', 'correct', 'topic', 'subtopic',
                    'grade', 'timestamp'])
                 && d.keys().hasAll(
                   ['question', 'user_answer', 'correct', 'topic', 'grade', 'timestamp'])
                 /* question_id is the compiled item's stable id (content build). OPTIONAL, so
                    records written before it existed stay valid and Audit keeps rendering
                    them. The question TEXT is still stored alongside it -- an id alone would
                    break Audit, which must render what the child saw without loading the
                    content JSON, and would break older rows if a question is reworded. */
                 && (!('question_id' in d) || d.question_id == null
                     || (d.question_id is string && d.question_id.size() <= 200))
                 && d.question is string && d.question.size() <= 4000
                 && d.user_answer is string && d.user_answer.size() <= 1000
                 && d.correct is bool
                 && d.topic in ['math', 'english', 'science']
                 && (!('subtopic' in d) || d.subtopic == null
                     || (d.subtopic is string && d.subtopic.size() <= 100))
                 // Upper bound tracks MAX_GRADE in app/js/flow.js. Grade 7 added 2026-09-02;
                 // until this was redeployed every grade-7 attempt failed permission-denied.
                 && d.grade is int && d.grade >= 1 && d.grade <= 7
                 && d.timestamp == request.time;
        }

        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validHistory(request.resource.data);
        // History is an audit trail: entries are not rewritten or removed by the client.
        allow update, delete: if false;
      }

      /* user_statistics: last_login, questions_attempted, topics_covered[], plus the
         per-grade/topic roll-up that keeps the Statistics page off a 1000-document read.

         Same reasoning as history. `allow write: if isOwner(uid)` previously permitted any
         shape at all: a client could arrayUnion thousands of junk entries into
         topics_covered, or add unbounded fields, to a document that EVERY Statistics view
         reads. Bloating it is a self-service denial of service against the owner's own bill.

         `write` also implied delete. Deleting the summary would silently reset a child's
         counters, so it is now create/update only. */
      match /statistics/{docId} {
        function validSummary(d) {
          return d.keys().hasOnly(
                   ['last_login', 'questions_attempted', 'topics_covered', 'updated_at',
                    'attempts_by', 'correct_by'])
                 && (!('questions_attempted' in d)
                     || (d.questions_attempted is int && d.questions_attempted >= 0))
                 && (!('topics_covered' in d)
                     || (d.topics_covered is list
                         && d.topics_covered.hasOnly(['math', 'english', 'science'])))
                 /* The roll-ups are keyed g<grade>_<topic>, so 7 grades x 3 topics bounds them
                    at 21 keys. Capping the key count is what stops the document growing
                    without limit; individual values being wrong would only mis-draw the
                    child's own chart, which is not a security question.

                    Was 18 while the site served grades 1-6. The cap MUST be raised with the
                    grade range: a child working across all seven grades would otherwise hit
                    the ceiling and have their statistics write rejected. */
                 && (!('attempts_by' in d)
                     || (d.attempts_by is map && d.attempts_by.keys().size() <= 21))
                 && (!('correct_by' in d)
                     || (d.correct_by is map && d.correct_by.keys().size() <= 21));
        }

        /* A crude write-rate floor. Rules cannot count requests over a window the way
           Flask-Limiter did (obs_app.py used "10 per minute" on submit_answer), but every
           recorded attempt updates this document, so a minimum interval here throttles
           attempt writes as a whole.

           One second, not legacy's six. Six would reject a fast-but-real student; one second
           between two answered questions is not a child, it is a script. data.js retries once
           after ~1.2s, so a genuine burst is delayed rather than lost. This bounds a
           compromised client to ~86k writes/day instead of unlimited -- a cap, not a defence.
           App Check is the control that actually keeps non-app clients out. */
        function notTooFast() {
          return !('updated_at' in resource.data)
                 || resource.data.updated_at == null
                 || request.time > resource.data.updated_at + duration.value(1, 's');
        }

        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validSummary(request.resource.data);
        allow update: if isOwner(uid) && validSummary(request.resource.data) && notTooFast();
        allow delete: if false;
      }

      /* MASTERY (2026-09-01, owner request): a question the child has already answered
         CORRECTLY is not served again until the whole subtopic has been worked through, at
         which point the list resets and questions may repeat.

         One document per grade+subject+subtopic, id `g<grade>_<subject>_<subtopic>`, holding
         the ids of items answered correctly. Practice reads exactly ONE document when it
         starts, and the write batches into the same commit as the history + statistics write,
         so it costs no extra round trip.

         Why not derive this from history instead: history grows with every attempt a child
         ever makes, so filtering from it would cost reads proportional to lifetime activity
         rather than to the size of one subtopic -- the wrong shape on a plan whose free quota
         is a hard cap. (question_id is nevertheless recorded in history as well, for audit and
         later analysis; this document is what practice actually reads.)

         The cap is what stops the array being used to bloat a document the child's own
         practice page reads on every start. 1000 ids is far above any real subtopic -- the
         largest today holds 163 -- while keeping the document small. */
      match /progress/{progressId} {
        function validProgress(d) {
          return d.keys().hasOnly(['mastered', 'updated_at'])
                 && d.keys().hasAll(['mastered', 'updated_at'])
                 && d.mastered is list && d.mastered.size() <= 1000;
        }

        // Owner only. Unlike history and statistics, Audit does not render mastery, so there
        // is no reason to widen this to admins.
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgress(request.resource.data);
        allow delete: if false;
      }
    }

    /* ---- invites / chat_sessions / messages: DROPPED, not merely unused --------------
       Collaboration was cut on 2026-09-01 (see the header). The allow rules that used to sit
       here are deleted so these collections fall through to the default deny below. Leaving
       them in place would have kept a writable child-messaging surface open in production
       with no UI in front of it and no one reading it. */

    // ---- Everything else is denied ------------------------------------------------------
    // Firestore evaluates rules as an OR of all matches, so this cannot override the allows
    // above; it exists to make the default explicit and to cover any future collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
